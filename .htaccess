# Protección para instalaciones con DocumentRoot apuntando a htdocs.
# Requiere AllowOverride FileInfo/All. En producción servir SOLO public/.
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(app|backups|database|deployment|docs|scripts|sql|tests|tools|vendor|respaldo[^/]*|correccion[^/]*)(/|$) - [F,L,NC]
RewriteRule (^|/)\.git(/|$) - [F,L,NC]
</IfModule>
<FilesMatch "(?i)^(\.env.*|composer\.(json|lock)|.*\.(sql|key|bak|backup|log|inc|ini)|.*\.backup_.*)$">
Require all denied
</FilesMatch>
