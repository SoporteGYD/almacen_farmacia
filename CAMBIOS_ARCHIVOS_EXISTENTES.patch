+/**
+ * CAJERO: esta cuenta solo puede trabajar en el POS del entorno de pruebas.
+ * La comprobación se realiza del lado del servidor; no es solo ocultar menú.
+ */
+function esCajeroPOS(?array $usuario = null): bool
+{
+    $usuario = $usuario ?? currentUser();
+    return strtoupper(trim((string) ($usuario['rol'] ?? ''))) === 'CAJERO';
+}
+
+function verificarAccesoCajeroPOS(): void
+{
+    if (!esCajeroPOS()) {
+        return;
+    }
+    $archivo = basename((string) ($_SERVER['SCRIPT_NAME'] ?? ''));
+    $permitidos = [
+        'pos_prueba.php', 'pos_ticket_prueba.php', 'logout.php',
+        'session_keepalive.php',
+    ];
+    if (in_array($archivo, $permitidos, true)) {
+        return;
+    }
+    http_response_code(403);
+    header('Content-Type: text/html; charset=utf-8');
+    echo '<!doctype html><html lang="es"><meta charset="utf-8"><title>Acceso limitado</title>';
+    echo '<main style="font:16px Arial;max-width:500px;margin:10vh auto">';
+    echo '<h2>Acceso exclusivo a Punto de Venta</h2>';
+    echo '<p>El usuario CAJERO no tiene autorización para abrir otros módulos.</p>';
+    echo '<p><a href="pos_prueba.php">Ir a Punto de Venta</a></p></main></html>';
+    exit;
+}
